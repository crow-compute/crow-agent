{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Crow Agent",
  "version": "0.1.10",
  "identifier": "ai.crowcompute.agent",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "security": {
      "csp": "default-src 'self'; connect-src 'none'; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline'; font-src 'self'; object-src 'none'; frame-src 'none'; base-uri 'none'; form-action 'none'"
    },
    "windows": [
      {
        "title": "Crow Agent",
        "width": 1180,
        "height": 780,
        "minWidth": 360,
        "minHeight": 600,
        "resizable": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "externalBin": [
      "binaries/crow-agentd"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "copyright": "Copyright © 2026 Crow Compute",
    "shortDescription": "User-hosted Crow trading agent and paper-arena controller"
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEVBNEE2MzhGQkRENzI3NDcKUldSSEo5ZTlqMk5LNmx0NGNiRUZWQmZOMmdDUFZjNmNXaHJCZXZ1R0tsbHBNV0liQ1B0dDdkOTgK"
    }
  }
}
